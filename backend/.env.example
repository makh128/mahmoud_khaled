# Copy to backend/.env and fill in the values (never commit the real file)

PORT=3001
# Comma-separated list of allowed origins, or * to allow any
CORS_ORIGIN=*

# Mail account used to send the contact-form emails (Gmail needs an App Password)
MAIL_USER=
MAIL_PASS=
# Optional: where messages are delivered / the From address (default to MAIL_USER)
MAIL_TO=
MAIL_FROM=

# Optional: custom SMTP server instead of Gmail
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_SECURE=true
